{
  "name": "codesign-mcp-server",
  "version": "1.0.2",
  "description": "MCP server for Tencent CoDesign — read design specs, layer annotations, and download slices",
  "type": "module",
  "bin": {
    "codesign-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geniyangge/codesign-mcp-server.git"
  },
  "homepage": "https://github.com/geniyangge/codesign-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/geniyangge/codesign-mcp-server/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "version:check": "node scripts/version.mjs",
    "version:sync": "node scripts/version.mjs --sync",
    "test": "npm run version:check && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm run version:check && npm run build"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codesign",
    "design",
    "figma-alternative"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
